<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-only stand-ins for the Citavi assemblies, used by CI (no Citavi on GitHub runners).
    They contain only the few types the bridge references directly; everything else is
    accessed via reflection at runtime. Never ship these.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Citavi</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
